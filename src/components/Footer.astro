---
import { WHATSAPP_URL } from '../consts';
---

<footer>
  <div class="footer-top">
    <div>
      <div class="footer-brand">
        CHICO SACOLAS
        <span>SACOLAS PERSONALIZADAS · GUARUJÁ</span>
        <span class="footer-area">Guarujá · Santos · São Vicente · Praia Grande · Cubatão · Bertioga · Mongaguá · Itanhaém · Peruíbe</span>
      </div>
    </div>
    <div>
      <div class="footer-col-title">Empresa</div>
      <a class="footer-link" href="#">Sobre nós</a>
      <a class="footer-link" href="#processo">Nosso processo</a>
      <a class="footer-link" href="#galeria">Portfolio</a>
    </div>
    <div>
      <div class="footer-col-title">Produtos</div>
      <a class="footer-link" href="#">Ecobags</a>
      <a class="footer-link" href="#">Sacolas de papel</a>
      <a class="footer-link" href="#">Formatos especiais</a>
    </div>
    <div>
      <div class="footer-col-title">Social</div>
      <a class="footer-link" href="#" target="_blank" rel="noopener">Instagram</a>
      <a class="footer-link" href={WHATSAPP_URL} target="_blank" rel="noopener">WhatsApp</a>
      <a class="footer-link" href="#" target="_blank" rel="noopener">LinkedIn</a>
    </div>
  </div>
  <div class="footer-bottom">
    <span class="footer-copy">© 2026 Chico Sacolas · Todos os direitos reservados</span>
    <span class="footer-brasil">Feito com orgulho no Brasil 🇧🇷</span>
  </div>
</footer>

<style>
footer {
  background: var(--ink);
  border-top: 4px solid var(--orange);
  padding: 48px 64px 36px;
}
.footer-top {
  display: grid;
  grid-template-columns: 1fr auto auto auto;
  gap: 48px;
  align-items: start;
  padding-bottom: 40px;
  border-bottom: 1px solid rgba(255,255,255,.06);
}
.footer-brand {
  font-family: 'Special Elite', monospace;
  font-size: 22px;
  letter-spacing: .1em;
  color: var(--paper);
}
.footer-brand span {
  display: block;
  font-size: 10px;
  letter-spacing: .22em;
  color: rgba(247,242,232,.3);
  margin-top: 5px;
}
.footer-area {
  font-size: 9px !important;
  letter-spacing: .18em !important;
  color: rgba(247,242,232,.18) !important;
  margin-top: 8px !important;
}
.footer-col-title {
  font-family: 'Special Elite', monospace;
  font-size: 10px;
  letter-spacing: .2em;
  color: rgba(247,242,232,.35);
  margin-bottom: 14px;
  text-transform: uppercase;
}
.footer-link {
  display: block;
  font-size: 18px;
  color: rgba(247,242,232,.6);
  text-decoration: none;
  margin-bottom: 6px;
  transition: color .15s;
}
.footer-link:hover { color: var(--orange); }
.footer-bottom {
  padding-top: 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.footer-copy {
  font-family: 'Special Elite', monospace;
  font-size: 10px;
  letter-spacing: .12em;
  color: rgba(247,242,232,.2);
}
.footer-brasil {
  font-family: 'Special Elite', monospace;
  font-size: 10px;
  letter-spacing: .16em;
  color: rgba(247,242,232,.2);
}

@media (max-width: 639px) {
  footer { padding: 40px 24px 28px; }
  .footer-top { grid-template-columns: 1fr 1fr; grid-template-rows: auto auto; gap: 32px; }
  .footer-brand { grid-column: 1 / -1; }
  .footer-bottom { flex-direction: column; gap: 8px; text-align: center; }
}

@media (min-width: 640px) and (max-width: 1023px) {
  footer { padding: 44px 36px 28px; }
  .footer-top { grid-template-columns: 1fr auto auto auto; gap: 28px; }
}
</style>
