---
import { Image } from 'astro:assets';
import logo from '../assets/logo-chico-sacolas.png';

const navLinks = [
  { label: 'Produtos', href: '#produtos' },
  { label: 'Galeria', href: '#galeria' },
  { label: 'Privacidade', href: '#privacidade' },
  { label: 'Contato', href: '#contato' },
];

const whatsappUrl = 'https://wa.me/5513997646549?text=Ol%C3%A1%2C%20gostaria%20de%20um%20or%C3%A7amento%20de%20sacolas%20personalizadas!';
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__top">
      <a href="/" class="footer__logo" aria-label="Chico Sacolas - página inicial">
        <Image src={logo} alt="Chico Sacolas" class="footer__logo-img" height={300} width={450} format="webp" loading="lazy" />
      </a>

      <nav class="footer__nav" aria-label="Links do rodapé">
        <ul class="footer__nav-list">
          {navLinks.map(({ label, href }) => (
            <li>
              <a class="footer__nav-link" href={href}>{label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <a href={whatsappUrl} class="footer__chat-btn" target="_blank" rel="noopener noreferrer" aria-label="Falar no WhatsApp">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
        </svg>
      </a>
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">© 2025 Chico Sacolas — O Workshop Profissional da sua Embalagem.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-paper);
    border-top: 1px solid var(--color-kraft);
    border-top-width: 2px;
  }

  .footer__inner {
    padding-block: var(--spacing-lg);
  }

  .footer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }

  .footer__logo {
    flex-shrink: 0;
  }

  .footer__logo-img {
    height: 150px;
    width: auto;
  }

  .footer__nav-list {
    display: flex;
    list-style: none;
    gap: var(--spacing-md);
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer__nav-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-brown);
    transition: color 0.2s;
  }

  .footer__nav-link:hover {
    color: var(--color-kraft-dark);
  }

  .footer__chat-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background-color: var(--color-whatsapp);
    color: var(--color-white);
    border-radius: var(--radius-full);
    flex-shrink: 0;
    transition: background-color 0.2s, transform 0.1s;
  }

  .footer__chat-btn:hover {
    background-color: var(--color-whatsapp-dark);
    transform: translateY(-2px);
  }

  .footer__bottom {
    margin-top: var(--spacing-md);
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--color-kraft);
    opacity: 0.4;
  }

  .footer__copyright {
    font-size: 0.875rem;
    color: var(--color-charcoal);
    text-align: center;
  }

  @media (max-width: 768px) {
    .footer__top {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--spacing-md);
    }

    .footer__chat-btn {
      order: -1;
      align-self: flex-end;
    }
  }
</style>
