---
import { Image } from 'astro:assets';
import heroSacola from '../assets/images/hero-sacola.png';
---

<section class="hero" id="inicio">
  <div class="hero-left">
    <span class="eyebrow light">Guarujá · Santos · Baixada Santista · Desde 20XX</span>
    <h1 class="hero-h1">
      Sacolas personalizadas<br>
      para sua marca<br>
      <em>vender com mais presença</em>
    </h1>
    <p class="hero-sub">Sacolas kraft personalizadas com sua logo para lojas, eventos e promoções. Atendemos Guarujá, Santos e toda a Baixada Santista.</p>
    <div class="hero-cta-row">
      <a href="#contato" class="btn btn-primary">Ver nosso trabalho →</a>
      <a href="#processo" class="btn btn-outline" style="color:rgba(247,242,232,.7);border-color:rgba(247,242,232,.2);">Como funciona</a>
    </div>
    <div class="hero-stats">
      <div>
        <div class="hero-stat-n">500+</div>
        <div class="hero-stat-l">Clientes atendidos</div>
      </div>
      <div>
        <div class="hero-stat-n">12</div>
        <div class="hero-stat-l">Anos de mercado</div>
      </div>
      <div>
        <div class="hero-stat-n">48h</div>
        <div class="hero-stat-l">Retorno garantido</div>
      </div>
    </div>
  </div>

  <div class="hero-right">
    <Image
      src={heroSacola}
      alt="Sacola personalizada com serigrafia"
      class="hero-photo"
      loading="eager"
      fetchpriority="high"
    />
    <span class="hero-photo-tag">SACOLA PERSONALIZADA · SERIGRAFIA</span>
  </div>

  <div class="scroll-hint">
    <div class="scroll-hint-line"></div>
    <span>Role para baixo</span>
  </div>
</section>

<style>
.hero {
  min-height: 100vh;
  background: var(--ink);
  display: grid;
  grid-template-columns: 1fr 1fr;
  position: relative;
  overflow: hidden;
  padding-top: 64px;
}
.hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: repeating-linear-gradient(
    0deg, transparent, transparent 3px,
    rgba(255,255,255,.012) 3px, rgba(255,255,255,.012) 4px
  );
  pointer-events: none;
  z-index: 1;
}
.hero-left {
  padding: 80px 64px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 28px;
  position: relative;
  z-index: 2;
}
.hero-h1 {
  font-family: 'Special Elite', monospace;
  font-weight: 400;
  letter-spacing: .04em;
  line-height: 1.1;
  font-size: 64px;
  color: var(--paper);
  text-wrap: pretty;
}
.hero-h1 em {
  font-style: normal;
  color: var(--orange);
  position: relative;
}
.hero-h1 em::after {
  content: '';
  position: absolute;
  left: 0; right: 0;
  bottom: 2px;
  height: 3px;
  background: var(--orange);
  opacity: .4;
}
.hero-sub {
  font-size: 22px;
  color: rgba(247,242,232,.65);
  max-width: 400px;
  line-height: 1.45;
}
.hero-cta-row {
  display: flex;
  gap: 16px;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 8px;
}
.hero-right {
  position: relative;
  z-index: 2;
}
.hero-photo {
  width: 100%;
  height: 100%;
  min-height: 500px;
  object-fit: cover;
  object-position: center;
  display: block;
}
.hero-photo-tag {
  position: absolute;
  bottom: 36px;
  left: -1px;
  background: var(--orange);
  color: #fff;
  font-family: 'Special Elite', monospace;
  font-size: 11px;
  letter-spacing: .16em;
  padding: 8px 20px;
  z-index: 3;
}
.hero-stats {
  display: flex;
  gap: 40px;
  margin-top: 12px;
  padding-top: 24px;
  border-top: 1px solid rgba(255,255,255,.1);
}
.hero-stat-n {
  font-size: 40px;
  font-weight: 700;
  color: var(--orange);
  line-height: 1;
}
.hero-stat-l {
  font-family: 'Special Elite', monospace;
  font-size: 10px;
  letter-spacing: .16em;
  color: rgba(247,242,232,.4);
  margin-top: 3px;
}
.scroll-hint {
  position: absolute;
  bottom: 32px;
  left: 64px;
  display: flex;
  align-items: center;
  gap: 10px;
  z-index: 3;
}
.scroll-hint-line {
  width: 40px;
  height: 1px;
  background: var(--orange);
}
.scroll-hint span {
  font-family: 'Special Elite', monospace;
  font-size: 10px;
  letter-spacing: .2em;
  color: rgba(247,242,232,.35);
}

@keyframes fade-up {
  from { opacity: 0; transform: translateY(24px); }
  to   { opacity: 1; transform: translateY(0); }
}
.hero-left > * {
  opacity: 0;
  animation: fade-up .6s ease forwards;
}
.hero-left > *:nth-child(1) { animation-delay: .1s; }
.hero-left > *:nth-child(2) { animation-delay: .22s; }
.hero-left > *:nth-child(3) { animation-delay: .34s; }
.hero-left > *:nth-child(4) { animation-delay: .46s; }
.hero-left > *:nth-child(5) { animation-delay: .58s; }

@keyframes reveal-photo {
  from { clip-path: inset(0 100% 0 0); }
  to   { clip-path: inset(0 0% 0 0); }
}
.hero-right {
  animation: reveal-photo .9s cubic-bezier(.77,0,.18,1) .3s both;
}

@media (max-width: 639px) {
  .hero {
    grid-template-columns: 1fr;
    grid-template-rows: auto auto;
    min-height: auto;
    padding-top: 56px;
  }
  .hero-left { padding: 48px 24px 36px; gap: 20px; order: 2; }
  .hero-right { order: 1; }
  .hero-photo { min-height: 280px; max-height: 360px; }
  .hero-h1 { font-size: 36px; }
  .hero-sub { font-size: 18px; max-width: 100%; }
  .hero-cta-row { flex-direction: column; align-items: flex-start; gap: 10px; }
  .hero-stats { gap: 20px; flex-wrap: wrap; }
  .hero-stat-n { font-size: 30px; }
  .scroll-hint { display: none; }
  .hero-photo-tag { font-size: 9px; padding: 6px 14px; bottom: 16px; }
}

@media (min-width: 640px) and (max-width: 1023px) {
  .hero { grid-template-columns: 1fr 1fr; min-height: 100vh; padding-top: 64px; }
  .hero-left { padding: 48px 36px; gap: 22px; }
  .hero-h1 { font-size: 48px; }
  .hero-sub { font-size: 19px; }
  .hero-stats { gap: 24px; }
  .hero-stat-n { font-size: 32px; }
  .scroll-hint { left: 36px; }
}

@media (min-width: 1280px) {
  .hero-h1 { font-size: 72px; }
}
</style>
