---
import { WHATSAPP_URL } from '../consts';
---

<a class="whatsapp-float" href={WHATSAPP_URL} target="_blank" rel="noopener" aria-label="Chamar no WhatsApp">
  <span class="whatsapp-label">Chamar no WhatsApp</span>
  <div class="whatsapp-btn">
    <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
      <path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.558 4.111 1.528 5.836L0 24l6.335-1.502A11.94 11.94 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.79 9.79 0 01-5.007-1.374l-.36-.213-3.76.892.934-3.651-.235-.375A9.772 9.772 0 012.182 12C2.182 6.577 6.577 2.182 12 2.182S21.818 6.577 21.818 12 17.423 21.818 12 21.818z"/>
    </svg>
  </div>
</a>

<style>
.whatsapp-float {
  position: fixed;
  bottom: 28px;
  right: 28px;
  z-index: 300;
  display: flex;
  align-items: center;
  gap: 0;
  filter: drop-shadow(0 4px 16px rgba(0,0,0,.3));
}
.whatsapp-label {
  background: var(--ink);
  color: var(--paper);
  font-family: 'Special Elite', monospace;
  font-size: 11px;
  letter-spacing: .12em;
  padding: 12px 16px;
  border: 2px solid var(--ink);
  border-right: none;
  white-space: nowrap;
  transform: translateX(120%);
  opacity: 0;
  transition: transform .25s, opacity .25s;
  pointer-events: none;
}
.whatsapp-float:hover .whatsapp-label {
  transform: translateX(0);
  opacity: 1;
}
.whatsapp-btn {
  background: var(--green-whats);
  color: #fff;
  width: 56px;
  height: 56px;
  border: 2.5px solid var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  text-decoration: none;
  transition: transform .15s;
  flex-shrink: 0;
}
.whatsapp-btn:hover { transform: scale(1.08); }
.whatsapp-btn svg { width: 26px; height: 26px; }

@media (max-width: 639px) {
  .whatsapp-float { bottom: 20px; right: 20px; }
  .whatsapp-btn { width: 50px; height: 50px; }
  .whatsapp-label { display: none; }
}
</style>
