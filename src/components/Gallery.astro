---
import { Image } from 'astro:assets';
import gallery1 from '../assets/images/gallery-1.png';
import gallery2 from '../assets/images/gallery-2.png';
import gallery3 from '../assets/images/gallery-3.png';
import gallery4 from '../assets/images/gallery-4.png';
---

<section class="gallery" id="galeria">
  <div class="gallery-header">
    <div>
      <p class="eyebrow light" style="margin-bottom:10px;">Portfolio</p>
      <h2 class="gallery-title">Trabalhos que<br>falam por si.</h2>
    </div>
    <a href="#contato" class="btn btn-primary" style="align-self:flex-end;">Ver todos →</a>
  </div>

  <div class="gallery-grid">
    <div class="gallery-item">
      <Image src={gallery1} alt="Sacola preta premium com corda" class="gallery-img" loading="lazy" />
      <div class="gallery-hover-label"><span>SACOLA PREMIUM · CORDA PRETA</span></div>
    </div>
    <div class="gallery-item">
      <Image src={gallery2} alt="Sacola kraft com acabamento fino" class="gallery-img" loading="lazy" />
      <div class="gallery-hover-label"><span>SACOLA KRAFT · ACABAMENTO FINO</span></div>
    </div>
    <div class="gallery-item">
      <Image src={gallery3} alt="Sacola branca luxo com serigrafia" class="gallery-img" loading="lazy" />
      <div class="gallery-hover-label"><span>COLEÇÃO LUXO · SERIGRAFIA</span></div>
    </div>
    <div class="gallery-item">
      <Image src={gallery4} alt="Sacola com estampa total full print" class="gallery-img" loading="lazy" />
      <div class="gallery-hover-label"><span>ESTAMPA TOTAL · FULL PRINT</span></div>
    </div>
    <div class="gallery-item">
      <div class="photo-ph dark"></div>
      <div class="gallery-hover-label"><span>TECIDO · 4 CORES</span></div>
    </div>
    <div class="gallery-item">
      <div class="photo-ph dark"></div>
      <div class="gallery-hover-label"><span>FORMATO ESPECIAL</span></div>
    </div>
  </div>
</section>

<style>
.gallery {
  background: var(--ink);
  padding: 100px 64px;
}
.gallery-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 48px;
  gap: 24px;
}
.gallery-title {
  font-family: 'Special Elite', monospace;
  font-weight: 400;
  letter-spacing: .04em;
  line-height: 1.1;
  font-size: 52px;
  color: var(--paper);
}
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  grid-template-rows: 280px 280px;
  gap: 8px;
}
.gallery-item { overflow: hidden; position: relative; }
.gallery-item:nth-child(1) { grid-column: 1 / 6; grid-row: 1 / 2; }
.gallery-item:nth-child(2) { grid-column: 6 / 9; grid-row: 1 / 2; }
.gallery-item:nth-child(3) { grid-column: 9 / 13; grid-row: 1 / 3; }
.gallery-item:nth-child(4) { grid-column: 1 / 4; grid-row: 2 / 3; }
.gallery-item:nth-child(5) { grid-column: 4 / 7; grid-row: 2 / 3; }
.gallery-item:nth-child(6) { grid-column: 7 / 9; grid-row: 2 / 3; }
.gallery-img { width: 100%; height: 100%; object-fit: cover; display: block; }
.gallery-hover-label {
  position: absolute;
  inset: 0;
  background: rgba(224,92,42,.0);
  display: flex;
  align-items: flex-end;
  padding: 20px;
  opacity: 0;
  transition: opacity .25s, background .25s;
}
.gallery-item:hover .gallery-hover-label {
  opacity: 1;
  background: rgba(224,92,42,.55);
}
.gallery-hover-label span {
  font-family: 'Special Elite', monospace;
  font-size: 11px;
  letter-spacing: .18em;
  color: #fff;
}

@media (max-width: 639px) {
  .gallery { padding: 60px 24px; }
  .gallery-header { flex-direction: column; align-items: flex-start; gap: 20px; }
  .gallery-title { font-size: 28px; }
  .gallery-grid {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 180px 180px 180px;
    gap: 6px;
  }
  .gallery-item:nth-child(1) { grid-column: 1 / 3; grid-row: 1 / 2; }
  .gallery-item:nth-child(2) { grid-column: 1 / 2; grid-row: 2 / 3; }
  .gallery-item:nth-child(3) { grid-column: 2 / 3; grid-row: 2 / 3; }
  .gallery-item:nth-child(4) { grid-column: 1 / 2; grid-row: 3 / 4; }
  .gallery-item:nth-child(5) { grid-column: 2 / 3; grid-row: 3 / 4; }
  .gallery-item:nth-child(6) { display: none; }
}

@media (min-width: 640px) and (max-width: 1023px) {
  .gallery { padding: 72px 36px; }
  .gallery-title { font-size: 36px; }
  .gallery-grid {
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: 220px 220px;
    gap: 6px;
  }
  .gallery-item:nth-child(1) { grid-column: 1 / 4; grid-row: 1 / 2; }
  .gallery-item:nth-child(2) { grid-column: 4 / 7; grid-row: 1 / 2; }
  .gallery-item:nth-child(3) { grid-column: 1 / 3; grid-row: 2 / 3; }
  .gallery-item:nth-child(4) { grid-column: 3 / 5; grid-row: 2 / 3; }
  .gallery-item:nth-child(5) { grid-column: 5 / 7; grid-row: 2 / 3; }
  .gallery-item:nth-child(6) { display: none; }
}

@media (min-width: 1280px) {
  .gallery-title { font-size: 60px; }
}
</style>
