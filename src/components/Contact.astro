---
---

<section class="contact" id="contato">
  <div class="contact-left">
    <div>
      <p class="eyebrow orange" style="margin-bottom:12px;">Fale com a gente</p>
      <h2 class="contact-h">Pronto para fazer sua <em>sacola?</em></h2>
    </div>
    <p class="contact-p">Conta seu projeto pra gente. Respondemos com orçamento, prazo e uma sugestão de material — tudo sem compromisso.</p>
    <div class="contact-info">
      <div class="contact-info-row">
        <div class="contact-info-icon" aria-hidden="true">📍</div>
        <span class="contact-info-text">Guarujá - São Paulo, Brasil</span>
      </div>
      <div class="contact-info-row">
        <div class="contact-info-icon" aria-hidden="true">✉</div>
        <span class="contact-info-text">contato@chicosacolas.com.br</span>
      </div>
      <div class="contact-info-row">
        <div class="contact-info-icon" aria-hidden="true">📞</div>
        <a
          class="contact-info-text"
          href="tel:+5513997646549"
          data-event="click_phone"
          data-location="contact"
        >+55 13 9 9764-6549</a>
      </div>
    </div>
  </div>

  <form
    id="contact-form"
    class="contact-form"
    action="/api/orcamento"
    method="post"
    style="border:2px solid var(--light);"
    data-event="form_submit"
    data-location="contact_form"
  >
    <input type="hidden" name="_source" value="Formulário de Contato" />
    <div class="form-row">
      <div class="form-field">
        <label class="form-label" for="c-nome">Nome completo</label>
        <input class="form-input" id="c-nome" name="nome" type="text" placeholder="João Silva" required />
      </div>
      <div class="form-field">
        <label class="form-label" for="c-empresa">Empresa</label>
        <input class="form-input" id="c-empresa" name="empresa" type="text" placeholder="Sua empresa" />
      </div>
    </div>
    <div class="form-row">
      <div class="form-field">
        <label class="form-label" for="c-email">E-mail</label>
        <input class="form-input" id="c-email" name="email" type="email" placeholder="voce@empresa.com" required />
      </div>
      <div class="form-field">
        <label class="form-label" for="c-whatsapp">WhatsApp</label>
        <input class="form-input" id="c-whatsapp" name="whatsapp" type="tel" placeholder="+55 13 90000-0000" />
      </div>
    </div>
    <div class="form-row">
      <div class="form-field">
        <label class="form-label" for="c-tipo">Tipo de sacola</label>
        <input class="form-input" id="c-tipo" name="tipo" type="text" placeholder="Ecobag, papel, tecido..." />
      </div>
      <div class="form-field">
        <label class="form-label" for="c-qtd">Quantidade estimada</label>
        <input class="form-input" id="c-qtd" name="quantidade" type="text" placeholder="Ex: 500 unidades" />
      </div>
    </div>
    <div class="form-field full" style="border-bottom:2px solid var(--light); border-right:2px solid var(--light);">
      <label class="form-label" for="c-projeto">Conte seu projeto</label>
      <textarea class="form-textarea" id="c-projeto" name="projeto" placeholder="Descreva sua ideia, prazo, referências..."></textarea>
    </div>
    <div class="form-submit-row">
      <button
        type="submit"
        id="contact-btn"
        class="btn btn-primary"
        data-event="click_contact_submit"
        data-location="contact_form"
      >Enviar mensagem →</button>
      <p class="form-note" id="contact-note">Respondemos em até 48h<br>em dias úteis.</p>
    </div>
  </form>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const btn = document.getElementById('contact-btn') as HTMLButtonElement;
    const note = document.getElementById('contact-note') as HTMLElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = 'Enviando...';

      try {
        const res = await fetch('/api/orcamento', { method: 'POST', body: new FormData(form) });
        const data = await res.json() as { ok: boolean };

        if (data.ok) {
          form.reset();
          btn.textContent = 'Mensagem enviada!';
          note.textContent = 'Em breve entraremos em contato.';
          window.dataLayer?.push({ event: 'form_submit_success', form_location: 'contact_form' });
          window.fbq?.('track', 'Lead', { content_name: 'contact_form' });
        } else {
          throw new Error('send_failed');
        }
      } catch {
        btn.disabled = false;
        btn.textContent = 'Enviar mensagem →';
        note.innerHTML = 'Erro ao enviar. Tente via<br><a href="https://wa.me/5513997646549" style="color:var(--orange)">WhatsApp</a>.';
      }
    });
  </script>
</section>

<style>
.contact {
  background: var(--paper);
  padding: 100px 64px;
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 80px;
  align-items: start;
  border-top: 2px solid var(--light);
}
.contact-left {
  display: flex;
  flex-direction: column;
  gap: 28px;
  position: sticky;
  top: 80px;
}
.contact-h {
  font-family: 'Special Elite', monospace;
  font-weight: 400;
  letter-spacing: .04em;
  line-height: 1.1;
  font-size: 48px;
}
.contact-h em { font-style: normal; color: var(--orange); }
.contact-p {
  font-size: 20px;
  color: var(--mid);
  line-height: 1.5;
}
.contact-info {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-top: 8px;
}
.contact-info-row {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 18px;
}
.contact-info-icon {
  width: 36px;
  height: 36px;
  border: 2px solid var(--light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
  flex-shrink: 0;
}
.contact-info-text { color: var(--mid); }
.contact-form {
  display: flex;
  flex-direction: column;
  gap: 0;
}
.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
}
.form-field {
  display: flex;
  flex-direction: column;
  gap: 0;
  border-bottom: 2px solid var(--light);
  border-right: 2px solid var(--light);
  padding: 20px 24px;
  transition: background .2s, border-color .2s;
}
.form-field:focus-within {
  background: var(--warm-white);
  border-color: var(--orange);
}
.form-field.full { grid-column: 1 / -1; border-right: none; }
.form-field:last-of-type { border-bottom: none; }
.form-field:nth-child(even) { border-right: none; }
.form-label {
  font-family: 'Special Elite', monospace;
  font-size: 9px;
  letter-spacing: .2em;
  color: var(--mid);
  margin-bottom: 4px;
  text-transform: uppercase;
}
.form-input {
  background: transparent;
  border: none;
  font-family: 'Caveat', cursive;
  font-size: 20px;
  color: var(--ink);
  outline: none;
  width: 100%;
}
.form-input::placeholder { color: var(--light); }
.form-textarea {
  background: transparent;
  border: none;
  font-family: 'Caveat', cursive;
  font-size: 20px;
  color: var(--ink);
  outline: none;
  width: 100%;
  min-height: 100px;
  resize: none;
}
.form-textarea::placeholder { color: var(--light); }
.form-submit-row {
  margin-top: 32px;
  display: flex;
  align-items: center;
  gap: 20px;
}
.form-note {
  font-family: 'Special Elite', monospace;
  font-size: 10px;
  letter-spacing: .12em;
  color: var(--mid);
  line-height: 1.6;
}

@media (max-width: 639px) {
  .contact { grid-template-columns: 1fr; gap: 40px; padding: 60px 24px; }
  .contact-left { position: static; }
  .contact-h { font-size: 32px; }
  .form-row { grid-template-columns: 1fr; }
  .form-field { border-right: none !important; }
  .form-submit-row { flex-direction: column; align-items: flex-start; gap: 12px; }
}

@media (min-width: 640px) and (max-width: 1023px) {
  .contact { grid-template-columns: 1fr; gap: 48px; padding: 72px 36px; }
  .contact-left { position: static; }
  .contact-h { font-size: 38px; }
  .form-row { grid-template-columns: 1fr 1fr; }
}

@media (min-width: 1280px) {
  .contact-h { font-size: 54px; }
}
</style>
