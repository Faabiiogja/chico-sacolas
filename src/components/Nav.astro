---
import { WHATSAPP_URL } from '../consts';
---

<nav>
  <a href="#" class="nav-wordmark">CHICO <span>SACOLAS</span></a>
  <a href="#contato" class="nav-cta">Pedir Orçamento</a>
</nav>

<style>
nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 200;
  padding: 0 48px;
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(13,13,13,.92);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(255,255,255,.06);
}
.nav-wordmark {
  font-family: 'Special Elite', monospace;
  font-size: 18px;
  letter-spacing: .14em;
  color: var(--paper);
  text-decoration: none;
}
.nav-wordmark span { color: var(--orange); }
.nav-cta {
  font-family: 'Special Elite', monospace;
  font-size: 13px;
  letter-spacing: .1em;
  color: var(--orange);
  border: 1.5px solid var(--orange);
  padding: 7px 20px;
  text-decoration: none;
  transition: background .15s, color .15s;
}
.nav-cta:hover { background: var(--orange); color: #fff; }

@media (max-width: 639px) {
  nav { padding: 0 20px; height: 56px; }
  .nav-wordmark { font-size: 15px; }
  .nav-cta { font-size: 11px; padding: 6px 14px; }
}

@media (min-width: 640px) and (max-width: 1023px) {
  nav { padding: 0 32px; }
}
</style>
