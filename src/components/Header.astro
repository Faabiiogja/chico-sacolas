---
import { Image } from 'astro:assets';
import logo from '../assets/logo-chico-sacolas.png';

const navLinks = [
  { label: 'Produtos', href: '#produtos' },
  { label: 'Galeria', href: '#galeria' },
  { label: 'Processo', href: '#processo' },
  { label: 'Diferenciais', href: '#diferenciais' },
  { label: 'FAQ', href: '#faq' },
];

const whatsappUrl = 'https://wa.me/5513997646549?text=Ol%C3%A1%2C%20gostaria%20de%20um%20or%C3%A7amento%20de%20sacolas%20personalizadas!';
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="header__logo" aria-label="Chico Sacolas - página inicial">
      <Image src={logo} alt="Chico Sacolas" class="header__logo-img" height={160} width={240} format="webp" loading="eager" fetchpriority="high" />
    </a>

    <nav class="header__nav" aria-label="Menu principal">
      <ul class="header__nav-list">
        {navLinks.map(({ label, href }) => (
          <li>
            <a class="header__nav-link" href={href}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a href={whatsappUrl} class="header__cta" target="_blank" rel="noopener noreferrer">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
      </svg>
      Pedir orçamento
    </a>

    <button class="header__menu-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="header__mobile-menu" id="mobile-menu" aria-hidden="true">
    <nav aria-label="Menu mobile">
      <ul class="header__mobile-list">
        {navLinks.map(({ label, href }) => (
          <li>
            <a class="header__mobile-link" href={href}>{label}</a>
          </li>
        ))}
        <li>
          <a href={whatsappUrl} class="header__mobile-cta" target="_blank" rel="noopener noreferrer">
            Pedir orçamento no WhatsApp
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-cream);
    border-bottom: 1px solid var(--color-paper);
    box-shadow: 0 1px 12px rgba(43, 37, 32, 0.06);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    height: 68px;
  }

  .header__logo {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .header__logo-img {
    height: 80px;
    width: auto;
  }

  .header__nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .header__nav-list {
    display: flex;
    list-style: none;
    gap: 4px;
  }

  .header__nav-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-charcoal);
    padding: 6px 12px;
    border-radius: var(--radius-md);
    transition: color 0.2s, background-color 0.2s;
  }

  .header__nav-link:hover {
    color: var(--color-kraft-dark);
    background-color: var(--color-paper);
  }

  .header__cta {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background-color: var(--color-whatsapp);
    color: var(--color-white);
    font-size: 0.9375rem;
    font-weight: 600;
    border-radius: var(--radius-full);
    white-space: nowrap;
    transition: background-color 0.2s, transform 0.1s;
    flex-shrink: 0;
  }

  .header__cta:hover {
    background-color: var(--color-whatsapp-dark);
    transform: translateY(-1px);
  }

  .header__menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  .header__menu-toggle span {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--color-charcoal);
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }

  .header__menu-toggle:hover {
    background-color: var(--color-paper);
  }

  .header__mobile-menu {
    display: none;
    background-color: var(--color-cream);
    border-top: 1px solid var(--color-paper);
  }

  .header__mobile-menu.is-open {
    display: block;
  }

  .header__mobile-list {
    list-style: none;
    padding: var(--spacing-sm) 0;
  }

  .header__mobile-link {
    display: block;
    padding: 12px var(--spacing-md);
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-charcoal);
    transition: background-color 0.2s;
  }

  .header__mobile-link:hover {
    background-color: var(--color-paper);
    color: var(--color-kraft-dark);
  }

  .header__mobile-cta {
    display: block;
    margin: var(--spacing-sm) var(--spacing-md);
    padding: 12px var(--spacing-md);
    background-color: var(--color-whatsapp);
    color: var(--color-white);
    font-weight: 600;
    text-align: center;
    border-radius: var(--radius-full);
  }

  @media (max-width: 768px) {
    .header__nav,
    .header__cta {
      display: none;
    }

    .header__menu-toggle {
      display: flex;
      margin-left: auto;
    }
  }
</style>

<script>
  const toggle = document.querySelector('.header__menu-toggle');
  const menu = document.querySelector('.header__mobile-menu');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(isOpen));
    menu?.setAttribute('aria-hidden', String(!isOpen));
  });

  document.querySelectorAll('.header__mobile-link').forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      menu?.setAttribute('aria-hidden', 'true');
    });
  });
</script>
