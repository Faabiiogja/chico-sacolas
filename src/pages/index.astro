---
import Layout from '../layouts/Layout.astro';

const whatsappUrl = 'https://wa.me/5513997646549?text=Ol%C3%A1%2C%20gostaria%20de%20um%20or%C3%A7amento%20de%20sacolas%20personalizadas!';
---

<Layout>

<!-- ═══ NAV ═══ -->
<nav>
  <a href="#" class="nav-wordmark">CHICO <span>SACOLAS</span></a>
  <a href="#contato" class="nav-cta">Pedir Orçamento</a>
</nav>

<!-- ═══ HERO ═══ -->
<section class="hero" id="inicio">
  <div class="hero-left">
    <span class="eyebrow light">Serigrafia · Guarujá · Desde 20XX</span>
    <h1 class="hero-h1">
      Sacolas que<br>
      carregam a<br>
      sua <em>marca.</em>
    </h1>
    <p class="hero-sub">Sacolas personalizadas para marcas que querem ser lembradas. Do briefing à entrega.</p>
    <div class="hero-cta-row">
      <a href="#contato" class="btn btn-primary">Ver nosso trabalho →</a>
      <a href="#processo" class="btn btn-outline" style="color:rgba(247,242,232,.7);border-color:rgba(247,242,232,.2);">Como funciona</a>
    </div>
    <div class="hero-stats">
      <div>
        <div class="hero-stat-n">500+</div>
        <div class="hero-stat-l">Clientes atendidos</div>
      </div>
      <div>
        <div class="hero-stat-n">12</div>
        <div class="hero-stat-l">Anos de mercado</div>
      </div>
      <div>
        <div class="hero-stat-n">48h</div>
        <div class="hero-stat-l">Retorno garantido</div>
      </div>
    </div>
  </div>

  <div class="hero-right">
    <img src="/images/hero-sacola.png"
         alt="Sacola personalizada com serigrafia"
         class="hero-photo"
         loading="eager"
         fetchpriority="high" />
    <span class="hero-photo-tag">SACOLA PERSONALIZADA · SERIGRAFIA</span>
  </div>

  <div class="scroll-hint">
    <div class="scroll-hint-line"></div>
    <span>Role para baixo</span>
  </div>
</section>

<!-- ═══ LEAD GEN ═══ -->
<section class="lead-section" id="orcamento">
  <div class="lead-section-left">
    <p class="eyebrow light" style="margin-bottom:10px;">Orçamento gratuito</p>
    <h2 class="lead-section-heading">Sua ideia, nossa tela.</h2>
    <p class="lead-section-sub">Sem compromisso. Resposta em 24h.</p>
  </div>
  <form class="lead-form" action={whatsappUrl} method="get" target="_blank">
    <div class="lead-field">
      <label for="lead-nome">Seu nome</label>
      <input id="lead-nome" type="text" placeholder="Maria Silva" />
    </div>
    <div class="lead-field">
      <label for="lead-email">E-mail</label>
      <input id="lead-email" type="email" placeholder="voce@empresa.com" />
    </div>
    <div class="lead-field">
      <label for="lead-tipo">Tipo de sacola</label>
      <select id="lead-tipo">
        <option disabled selected>Escolha...</option>
        <option>Sacola de papel</option>
        <option>Sacola de tecido</option>
        <option>Ecobag</option>
        <option>Formato personalizado</option>
      </select>
    </div>
    <button type="submit" class="btn-lead-submit">Pedir orçamento →</button>
  </form>
</section>

<!-- ═══ PROCESSO ═══ -->
<section class="features" id="processo">
  <div class="features-header">
    <div>
      <p class="eyebrow orange" style="margin-bottom:10px;">Nosso processo</p>
      <h2 class="features-title">Como a <em>serigrafia</em> transforma sua sacola.</h2>
    </div>
    <p class="features-desc">Dois processos que garantem resultado profissional, do primeiro ao último item da tiragem.</p>
  </div>

  <div class="features-grid">
    <div class="feature-card">
      <span class="feature-card-num" aria-hidden="true">01</span>
      <span class="feature-step">Passo 01 — Preparação</span>
      <h3 class="feature-h">Separação de cores com precisão cirúrgica</h3>
      <p class="feature-p">Cada cor da sua arte recebe uma tela exclusiva, gravada e posicionada com registro milimétrico. Bordas nítidas, cores vivas — em toda a tiragem, sem variação.</p>
      <div class="feature-diagram" aria-hidden="true">
        <svg width="200" height="80" viewBox="0 0 200 80">
          <rect x="20" y="10" width="160" height="18" rx="2" fill="none" stroke="#0d0d0d" stroke-width="1.5"/>
          <rect x="20" y="31" width="160" height="18" rx="2" fill="none" stroke="#e05c2a" stroke-width="1.5"/>
          <rect x="20" y="52" width="160" height="18" rx="2" fill="none" stroke="#0d0d0d" stroke-width="1.5" stroke-dasharray="4,3"/>
          <text x="100" y="22" text-anchor="middle" font-family="Special Elite" font-size="8" letter-spacing="3" fill="#0d0d0d">COR 01</text>
          <text x="100" y="43" text-anchor="middle" font-family="Special Elite" font-size="8" letter-spacing="3" fill="#e05c2a">COR 02</text>
          <text x="100" y="64" text-anchor="middle" font-family="Special Elite" font-size="8" letter-spacing="3" fill="#9b8f7a">COR 03</text>
        </svg>
      </div>
    </div>

    <div class="feature-card">
      <span class="feature-card-num" aria-hidden="true">02</span>
      <span class="feature-step">Passo 02 — Finalização</span>
      <h3 class="feature-h">Tinta fixada para durar tanto quanto a sua marca</h3>
      <p class="feature-p">Usamos tintas à base de plastisol e água, curadas em alta temperatura. Sem rachaduras, sem desbotamento — mesmo após uso intenso e lavagens frequentes.</p>
      <div class="feature-diagram" aria-hidden="true">
        <svg width="200" height="80" viewBox="0 0 200 80">
          <path d="M20 60 Q60 20 100 40 Q140 60 180 20" fill="none" stroke="#e05c2a" stroke-width="2"/>
          <circle cx="20" cy="60" r="4" fill="#e05c2a"/>
          <circle cx="100" cy="40" r="4" fill="#e05c2a"/>
          <circle cx="180" cy="20" r="4" fill="#e05c2a"/>
          <text x="20" y="74" font-family="Special Elite" font-size="7" letter-spacing="1" fill="#9b8f7a">APLICAÇÃO</text>
          <text x="80" y="74" font-family="Special Elite" font-size="7" letter-spacing="1" fill="#9b8f7a">CURA 180°C</text>
          <text x="158" y="74" font-family="Special Elite" font-size="7" letter-spacing="1" fill="#9b8f7a">PRONTO</text>
        </svg>
      </div>
    </div>
  </div>
</section>

<!-- ═══ GALERIA ═══ -->
<section class="gallery" id="galeria">
  <div class="gallery-header">
    <div>
      <p class="eyebrow light" style="margin-bottom:10px;">Portfolio</p>
      <h2 class="gallery-title">Trabalhos que<br>falam por si.</h2>
    </div>
    <a href="#contato" class="btn btn-primary" style="align-self:flex-end;">Ver todos →</a>
  </div>

  <div class="gallery-grid">
    <div class="gallery-item">
      <img src="/images/gallery-1.png" alt="Sacola preta premium com corda" loading="lazy" />
      <div class="gallery-hover-label"><span>SACOLA PREMIUM · CORDA PRETA</span></div>
    </div>
    <div class="gallery-item">
      <img src="/images/gallery-2.png" alt="Sacola kraft com acabamento fino" loading="lazy" />
      <div class="gallery-hover-label"><span>SACOLA KRAFT · ACABAMENTO FINO</span></div>
    </div>
    <div class="gallery-item">
      <img src="/images/gallery-3.png" alt="Sacola branca luxo com serigrafia" loading="lazy" />
      <div class="gallery-hover-label"><span>COLEÇÃO LUXO · SERIGRAFIA</span></div>
    </div>
    <div class="gallery-item">
      <img src="/images/gallery-4.png" alt="Sacola com estampa total full print" loading="lazy" />
      <div class="gallery-hover-label"><span>ESTAMPA TOTAL · FULL PRINT</span></div>
    </div>
    <div class="gallery-item">
      <div class="photo-ph dark"></div>
      <div class="gallery-hover-label"><span>TECIDO · 4 CORES</span></div>
    </div>
    <div class="gallery-item">
      <div class="photo-ph dark"></div>
      <div class="gallery-hover-label"><span>FORMATO ESPECIAL</span></div>
    </div>
  </div>
</section>

<!-- ═══ CONTATO ═══ -->
<section class="contact" id="contato">
  <div class="contact-left">
    <div>
      <p class="eyebrow orange" style="margin-bottom:12px;">Fale com a gente</p>
      <h2 class="contact-h">Pronto para fazer sua <em>sacola?</em></h2>
    </div>
    <p class="contact-p">Conta seu projeto pra gente. Respondemos com orçamento, prazo e uma sugestão de material — tudo sem compromisso.</p>
    <div class="contact-info">
      <div class="contact-info-row">
        <div class="contact-info-icon" aria-hidden="true">📍</div>
        <span class="contact-info-text">Guarujá - São Paulo, Brasil</span>
      </div>
      <div class="contact-info-row">
        <div class="contact-info-icon" aria-hidden="true">✉</div>
        <span class="contact-info-text">oi@chicosacolas.com</span>
      </div>
      <div class="contact-info-row">
        <div class="contact-info-icon" aria-hidden="true">📞</div>
        <span class="contact-info-text">+55 13 9 9764-6549</span>
      </div>
    </div>
  </div>

  <form class="contact-form" action={whatsappUrl} method="get" target="_blank" style="border:2px solid var(--light);">
    <div class="form-row">
      <div class="form-field">
        <label class="form-label" for="c-nome">Nome completo</label>
        <input class="form-input" id="c-nome" type="text" placeholder="João Silva" />
      </div>
      <div class="form-field">
        <label class="form-label" for="c-empresa">Empresa</label>
        <input class="form-input" id="c-empresa" type="text" placeholder="Sua empresa" />
      </div>
    </div>
    <div class="form-row">
      <div class="form-field">
        <label class="form-label" for="c-email">E-mail</label>
        <input class="form-input" id="c-email" type="email" placeholder="voce@empresa.com" />
      </div>
      <div class="form-field">
        <label class="form-label" for="c-whatsapp">WhatsApp</label>
        <input class="form-input" id="c-whatsapp" type="tel" placeholder="+55 13 90000-0000" />
      </div>
    </div>
    <div class="form-row">
      <div class="form-field">
        <label class="form-label" for="c-tipo">Tipo de sacola</label>
        <input class="form-input" id="c-tipo" type="text" placeholder="Ecobag, papel, tecido..." />
      </div>
      <div class="form-field">
        <label class="form-label" for="c-qtd">Quantidade estimada</label>
        <input class="form-input" id="c-qtd" type="text" placeholder="Ex: 500 unidades" />
      </div>
    </div>
    <div class="form-field full" style="border-bottom:2px solid var(--light); border-right:2px solid var(--light);">
      <label class="form-label" for="c-projeto">Conte seu projeto</label>
      <textarea class="form-textarea" id="c-projeto" placeholder="Descreva sua ideia, prazo, referências..."></textarea>
    </div>
    <div class="form-submit-row">
      <button type="submit" class="btn btn-primary">Enviar mensagem →</button>
      <p class="form-note">Respondemos em até 48h<br>em dias úteis.</p>
    </div>
  </form>
</section>

<!-- ═══ FOOTER ═══ -->
<footer>
  <div class="footer-top">
    <div>
      <div class="footer-brand">
        CHICO SACOLAS
        <span>SACOLAS PERSONALIZADAS · GUARUJÁ</span>
      </div>
    </div>
    <div>
      <div class="footer-col-title">Empresa</div>
      <a class="footer-link" href="#">Sobre nós</a>
      <a class="footer-link" href="#processo">Nosso processo</a>
      <a class="footer-link" href="#galeria">Portfolio</a>
    </div>
    <div>
      <div class="footer-col-title">Produtos</div>
      <a class="footer-link" href="#">Ecobags</a>
      <a class="footer-link" href="#">Sacolas de papel</a>
      <a class="footer-link" href="#">Formatos especiais</a>
    </div>
    <div>
      <div class="footer-col-title">Social</div>
      <a class="footer-link" href="#" target="_blank" rel="noopener">Instagram</a>
      <a class="footer-link" href={whatsappUrl} target="_blank" rel="noopener">WhatsApp</a>
      <a class="footer-link" href="#" target="_blank" rel="noopener">LinkedIn</a>
    </div>
  </div>
  <div class="footer-bottom">
    <span class="footer-copy">© 2026 Chico Sacolas · Todos os direitos reservados</span>
    <span class="footer-brasil">Feito com orgulho no Brasil 🇧🇷</span>
  </div>
</footer>

<!-- ═══ WHATSAPP FLOAT ═══ -->
<a class="whatsapp-float" href={whatsappUrl} target="_blank" rel="noopener" aria-label="Chamar no WhatsApp">
  <span class="whatsapp-label">Chamar no WhatsApp</span>
  <div class="whatsapp-btn">
    <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
      <path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.558 4.111 1.528 5.836L0 24l6.335-1.502A11.94 11.94 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.79 9.79 0 01-5.007-1.374l-.36-.213-3.76.892.934-3.651-.235-.375A9.772 9.772 0 012.182 12C2.182 6.577 6.577 2.182 12 2.182S21.818 6.577 21.818 12 17.423 21.818 12 21.818z"/>
    </svg>
  </div>
</a>

<style is:global>
/* ─── TYPOGRAPHY ─── */
.eyebrow {
  font-family: 'Special Elite', monospace;
  font-size: 11px;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--mid);
}
.eyebrow.light { color: rgba(255,255,255,.5); }
.eyebrow.orange { color: var(--orange); }

/* ─── BUTTONS ─── */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: 'Special Elite', monospace;
  font-size: 14px;
  letter-spacing: .14em;
  padding: 14px 36px;
  border: 2.5px solid var(--ink);
  cursor: pointer;
  text-decoration: none;
  transition: transform .12s, box-shadow .12s;
  border-radius: 0;
  line-height: 1;
}
.btn-primary {
  background: var(--orange);
  color: #fff;
  border-color: var(--ink);
  box-shadow: var(--shadow-ink);
}
.btn-primary:hover { transform: translate(-3px,-3px); box-shadow: 7px 7px 0 var(--ink); }
.btn-ink {
  background: var(--ink);
  color: var(--paper);
  border-color: var(--ink);
  box-shadow: var(--shadow-orange);
}
.btn-ink:hover { transform: translate(-3px,-3px); box-shadow: 7px 7px 0 var(--orange); }
.btn-outline {
  background: transparent;
  color: var(--ink);
  border-color: var(--ink);
  box-shadow: none;
}
.btn-outline:hover { background: var(--ink); color: var(--paper); }

/* ─── PHOTO PLACEHOLDER ─── */
.photo-ph {
  background-color: var(--light);
  background-image: repeating-linear-gradient(45deg, rgba(0,0,0,.06) 0, rgba(0,0,0,.06) 1px, transparent 0, transparent 50%);
  background-size: 10px 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 8px;
  position: relative;
  overflow: hidden;
  width: 100%;
  height: 100%;
}
.photo-ph::after {
  content: 'FOTO';
  font-family: 'Special Elite', monospace;
  font-size: 11px;
  letter-spacing: .25em;
  color: rgba(0,0,0,.2);
}
.photo-ph.dark {
  background-color: #1e1a16;
  background-image: repeating-linear-gradient(45deg, rgba(255,255,255,.04) 0, rgba(255,255,255,.04) 1px, transparent 0, transparent 50%);
}
.photo-ph.dark::after { color: rgba(255,255,255,.15); }

/* ═══════════════════
   NAV
═══════════════════ */
nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 200;
  padding: 0 48px;
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(13,13,13,.92);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(255,255,255,.06);
}
.nav-wordmark {
  font-family: 'Special Elite', monospace;
  font-size: 18px;
  letter-spacing: .14em;
  color: var(--paper);
  text-decoration: none;
}
.nav-wordmark span { color: var(--orange); }
.nav-cta {
  font-family: 'Special Elite', monospace;
  font-size: 13px;
  letter-spacing: .1em;
  color: var(--orange);
  border: 1.5px solid var(--orange);
  padding: 7px 20px;
  text-decoration: none;
  transition: background .15s, color .15s;
}
.nav-cta:hover { background: var(--orange); color: #fff; }

/* ═══════════════════
   HERO
═══════════════════ */
.hero {
  min-height: 100vh;
  background: var(--ink);
  display: grid;
  grid-template-columns: 1fr 1fr;
  position: relative;
  overflow: hidden;
  padding-top: 64px;
}
.hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: repeating-linear-gradient(
    0deg, transparent, transparent 3px,
    rgba(255,255,255,.012) 3px, rgba(255,255,255,.012) 4px
  );
  pointer-events: none;
  z-index: 1;
}
.hero-left {
  padding: 80px 64px 80px 64px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 28px;
  position: relative;
  z-index: 2;
}
.hero-h1 {
  font-family: 'Special Elite', monospace;
  font-weight: 400;
  letter-spacing: .04em;
  line-height: 1.1;
  font-size: 64px;
  color: var(--paper);
  text-wrap: pretty;
}
.hero-h1 em {
  font-style: normal;
  color: var(--orange);
  position: relative;
}
.hero-h1 em::after {
  content: '';
  position: absolute;
  left: 0; right: 0;
  bottom: 2px;
  height: 3px;
  background: var(--orange);
  opacity: .4;
}
.hero-sub {
  font-size: 22px;
  color: rgba(247,242,232,.65);
  max-width: 400px;
  line-height: 1.45;
}
.hero-cta-row {
  display: flex;
  gap: 16px;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 8px;
}
.hero-right {
  position: relative;
  z-index: 2;
}
.hero-photo {
  width: 100%;
  height: 100%;
  min-height: 500px;
  object-fit: cover;
  object-position: center;
  display: block;
}
.hero-photo-tag {
  position: absolute;
  bottom: 36px;
  left: -1px;
  background: var(--orange);
  color: #fff;
  font-family: 'Special Elite', monospace;
  font-size: 11px;
  letter-spacing: .16em;
  padding: 8px 20px;
  z-index: 3;
}
.hero-stats {
  display: flex;
  gap: 40px;
  margin-top: 12px;
  padding-top: 24px;
  border-top: 1px solid rgba(255,255,255,.1);
}
.hero-stat-n {
  font-size: 40px;
  font-weight: 700;
  color: var(--orange);
  line-height: 1;
}
.hero-stat-l {
  font-family: 'Special Elite', monospace;
  font-size: 10px;
  letter-spacing: .16em;
  color: rgba(247,242,232,.4);
  margin-top: 3px;
}
.scroll-hint {
  position: absolute;
  bottom: 32px;
  left: 64px;
  display: flex;
  align-items: center;
  gap: 10px;
  z-index: 3;
}
.scroll-hint-line {
  width: 40px;
  height: 1px;
  background: var(--orange);
}
.scroll-hint span {
  font-family: 'Special Elite', monospace;
  font-size: 10px;
  letter-spacing: .2em;
  color: rgba(247,242,232,.35);
}

/* ═══════════════════
   LEAD GEN
═══════════════════ */
.lead-section {
  background: var(--orange);
  padding: 56px 64px;
  display: flex;
  align-items: center;
  gap: 48px;
  border-top: 3px solid var(--ink);
  border-bottom: 3px solid var(--ink);
  position: relative;
  overflow: hidden;
}
.lead-section::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: radial-gradient(circle, rgba(0,0,0,.08) 1px, transparent 1px);
  background-size: 16px 16px;
  pointer-events: none;
}
.lead-section-left {
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}
.lead-section-heading {
  font-family: 'Special Elite', monospace;
  font-weight: 400;
  letter-spacing: .04em;
  line-height: 1.1;
  font-size: 44px;
  color: #fff;
  max-width: 280px;
}
.lead-section-sub {
  font-size: 18px;
  color: rgba(255,255,255,.75);
  margin-top: 8px;
}
.lead-form {
  display: flex;
  gap: 12px;
  flex: 1;
  flex-wrap: wrap;
  align-items: flex-end;
  position: relative;
  z-index: 1;
}
.lead-field {
  display: flex;
  flex-direction: column;
  gap: 6px;
  flex: 1;
  min-width: 160px;
}
.lead-field label {
  font-family: 'Special Elite', monospace;
  font-size: 10px;
  letter-spacing: .18em;
  color: rgba(255,255,255,.65);
}
.lead-field input,
.lead-field select {
  background: rgba(0,0,0,.2);
