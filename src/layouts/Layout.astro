---
import '../styles/global.css';
import '@fontsource-variable/caveat';
import '@fontsource/special-elite';
import StructuredData from '../components/StructuredData.astro';
import Analytics from '../components/Analytics.astro';
import { GTM_ID, COMPANY } from '../config/company';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  heroImageUrl?: string;
}

const {
  title = 'Sacolas Personalizadas em Guarujá e Santos | Chico Sacolas',
  description = 'Sacolas kraft, ecobags e sacolas para eventos com a sua logo, em serigrafia. Atendemos Guarujá, Santos e Baixada Santista. Orçamento grátis pelo WhatsApp.',
  canonicalUrl = `${COMPANY.url}/`,
  ogImage = COMPANY.image,
  heroImageUrl,
} = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=chico-sacolas" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png?v=chico-sacolas" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {heroImageUrl && <link rel="preload" href={heroImageUrl} as="image" type="image/webp" />}
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Chico Sacolas" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ecobag personalizada com logo em serigrafia, feita pela Chico Sacolas" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Geo -->
    <meta name="geo.region" content="BR-SP" />
    <meta name="geo.placename" content="Guarujá, São Paulo" />

    <title>{title}</title>

    <StructuredData />
    <Analytics />

  </head>
  <body>
    <!-- GTM noscript fallback -->
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>

    <slot />
  </body>
</html>
